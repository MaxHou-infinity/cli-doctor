{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cli-doctor",
  "version": "0.2.0",
  "description": "在 Codex 侧栏诊断本机 CLI 工具版本与已安装包的依赖影响。",
  "license": "MIT",
  "homepage": "https://github.com/MaxHou-infinity/cli-doctor",
  "repository": "https://github.com/MaxHou-infinity/cli-doctor",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "CLI Doctor",
        "shortDescription": "本机 CLI 工具链体检",
        "longDescription": "按生态展示本机 CLI 版本、可用更新和已安装包的依赖影响。只诊断，不执行工具升级。",
        "developerName": "MaxHou",
        "category": "Productivity",
        "capabilities": ["Read"],
        "brandColor": "#087C9F"
      }
    }
  }
}
