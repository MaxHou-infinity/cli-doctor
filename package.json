{
  "name": "cli-doctor",
  "version": "0.2.0",
  "description": "检查本机 CLI 工具与依赖包的版本现状（Homebrew / npm 全局 / Python pip / Rust·Bun·uv / 自更新类），输出分类报告，只报不升。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxHou-infinity/cli-doctor.git"
  },
  "homepage": "https://github.com/MaxHou-infinity/cli-doctor#readme",
  "bugs": {
    "url": "https://github.com/MaxHou-infinity/cli-doctor/issues"
  },
  "private": true,
  "main": "./dsh/src/host/index.js",
  "exports": {
    ".": "./dsh/src/host/index.js",
    "./client": "./dsh/lib/client.js",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "cli-doctor": "./bin/check.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "dsh",
    "bin",
    "assets",
    "SKILL.md",
    "README.md"
  ],
  "keywords": [
    "cli",
    "upgrade",
    "homebrew",
    "npm",
    "pip",
    "skill",
    "check",
    "cli-health",
    "dependency-audit",
    "version-checker",
    "developer-tools",
    "agent-skill",
    "agent-skills",
    "ai-agent",
    "codex",
    "claude-code",
    "macos",
    "brew",
    "bun",
    "rustup",
    "uv"
  ],
  "scripts": {
    "test": "node bin/check.js --no-update --fast",
    "test:codex": "node test/codex_plugin_smoke.js",
    "dashboard": "node dashboard/server.js"
  }
}
